  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #0B1117;
}

QWidget {
    background-color: #0B1117;
    color: #E6EDF3;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
}

/* TAB */
QTabWidget::pane {
    border: none;
    background: #0B1117;
}

QTabBar::tab {
    background: #111B26;
    color: #9FB3C8;
    padding: 10px 18px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 3px;
}

QTabBar::tab:selected {
    background: #1E3A5F;
    color: #FFFFFF;
}

QTabBar::tab:hover {
    background: #1A2A3A;
}

/* GROUPBOX */
QGroupBox {
    border: 1px solid #2F455C;
    border-radius: 10px;
    margin-top: 14px;
    padding: 12px;
    background-color: #141E2A;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #38BDF8;
    font-size: 11pt;
    font-weight: bold;
}

/* BUTTON */
QPushButton {
    background-color: #2563EB;
    color: white;
    border: none;
    border-radius: 7px;
    padding: 8px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #3B82F6;
}

QPushButton:pressed {
    background-color: #1D4ED8;
}

QPushButton:disabled {
    background-color: #334155;
    color: #94A3B8;
}

/* INPUT */
QLineEdit,
QComboBox,
QSpinBox {
    background-color: #0F1722;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px;
    color: #E6EDF3;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus {
    border: 1px solid #38BDF8;
}

/* COMBOBOX */
QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox QAbstractItemView {
    background-color: #0F1722;
    color: #E6EDF3;
    selection-background-color: #1E3A5F;
    border: 1px solid #334155;
}

/* CHECKBOX */
QCheckBox {
    spacing: 8px;
    color: #E6EDF3;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
}

QCheckBox::indicator:unchecked {
    background-color: #0F1722;
    border: 1px solid #64748B;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #38BDF8;
    border: 1px solid #38BDF8;
    border-radius: 3px;
}

/* LABEL */
QLabel {
    color: #E6EDF3;
}

/* SLIDER */
QSlider::groove:horizontal {
    height: 6px;
    background: #334155;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #38BDF8;
    width: 14px;
    margin: -5px 0px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #7DD3FC;
}

/* SCROLL AREA */
QScrollArea {
    border: none;
    background-color: #0B1117;
}

QScrollArea &gt; QWidget &gt; QWidget {
    background-color: #0B1117;
}

/* SCROLLBAR VERTICAL */
QScrollBar:vertical {
    background: #0B1117;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #2F455C;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #3B82F6;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* SCROLLBAR HORIZONTAL */
QScrollBar:horizontal {
    background: #0B1117;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #2F455C;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #3B82F6;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* VIDEO / PLOT PLACEHOLDER */
QLabel#Camera_frame,
QLabel#Mask_frame {
    background-color: #050A0F;
    border: 1px solid #415A77;
    border-radius: 6px;
    color: #E6EDF3;
    font-weight: bold;
}

QWidget#plot_frame,
QWidget#plot_frame_2,
QWidget#plot_frame_3 {
    background-color: #050A0F;
    border: 1px solid #243244;
    border-radius: 6px;
}</string>
